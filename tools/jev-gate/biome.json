{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": { "includes": ["**", "!dist", "!src/harness", "!pnpm-lock.yaml"] },
	"formatter": { "indentStyle": "tab", "lineWidth": 120 },
	"javascript": {
		"formatter": { "quoteStyle": "single" },
		"parser": { "unsafeParameterDecoratorsEnabled": true }
	},
	"linter": {
		"rules": {
			"preset": "recommended",
			"style": { "useImportType": "error", "useNodejsImportProtocol": "error" },
			"complexity": { "useLiteralKeys": "off" }
		}
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"overrides": [
		{
			"includes": ["test/**"],
			"linter": { "rules": { "style": { "noNonNullAssertion": "off" }, "suspicious": { "noExplicitAny": "off" } } }
		},
		{
			"includes": ["**/*.module.ts"],
			"linter": { "rules": { "complexity": { "noStaticOnlyClass": "off" } } }
		}
	]
}
