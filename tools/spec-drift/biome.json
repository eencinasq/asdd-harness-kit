{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!dist",
			"!src/harness",
			"!src/pr-review/engine/rules",
			"!src/pr-review/engine/data",
			"!pnpm-lock.yaml"
		]
	},
	"formatter": {
		"indentStyle": "tab",
		"lineWidth": 120
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single"
		},
		"parser": {
			"unsafeParameterDecoratorsEnabled": true
		}
	},
	"linter": {
		"rules": {
			"preset": "recommended",
			"style": {
				"useImportType": "error",
				"useNodejsImportProtocol": "error"
			},
			"complexity": {
				"useLiteralKeys": "off"
			}
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.spec.ts", "test/**"],
			"linter": {
				"rules": {
					"style": {
						"noNonNullAssertion": "off"
					},
					"suspicious": {
						"noExplicitAny": "off"
					}
				}
			}
		},
		{
			"includes": ["src/pr-review/engine/**"],
			"linter": {
				"rules": {
					"style": {
						"noNonNullAssertion": "off"
					}
				}
			}
		},
		{
			"includes": ["**/*.css"],
			"linter": {
				"rules": {
					"style": {
						"noDescendingSpecificity": "off"
					}
				}
			}
		},
		{
			"includes": ["ui/**/*.html"],
			"linter": {
				"rules": {
					"a11y": {
						"useSemanticElements": "off"
					}
				}
			}
		},
		{
			"includes": ["**/*.module.ts"],
			"linter": {
				"rules": {
					"complexity": {
						"noStaticOnlyClass": "off"
					}
				}
			}
		}
	]
}
