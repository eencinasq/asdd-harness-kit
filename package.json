{
  "name": "asdd-harness-kit",
  "version": "3.8.1",
  "description": "Portable process layer for Agent Specification-Driven Development (ASDD) and Harness Engineering",
  "bin": {
    "asdd-harness-kit": "scripts/npx-install.cjs"
  },
  "files": [
    ".agents/**/*",
    ".cursor/**/*",
    ".harness/**/*",
    "docs/**/*",
    "runtimes/**/*",
    "scripts/**/*",
    "AGENTS.md",
    "LICENSE",
    "README.md",
    "!.harness/knowledge/**",
    "!.harness/specs/*/**",
    "!.harness/features/*.features.json",
    "!.harness/state/slices/*/**",
    "!.harness/state/archive/*/**",
    "!.harness/state/archive/*.json",
    "!.harness/state/learning/**",
    "!.harness/state/registry.json",
    "!.harness/audits/*.json",
    "!.harness/config/project.json",
    "!.harness/steering/product.md",
    "!.harness/steering/structure.md",
    "!.harness/steering/tech.md",
    "!.harness/steering/domain-layer.project.md",
    "!.harness/steering/quality-gates.project.md",
    "!.harness/steering/design-system.md",
    "!docs/knowledge-base/steering-proposals/**",
    "!docs/architecture/domain-model.md",
    "!docs/agent-failure-log.md",
    "!docs/dissent-log.md"
  ],
  "scripts": {
    "test": "bash scripts/test-install-into.sh && bash scripts/test-lifecycle.sh && node --test scripts/check-guidance.test.mjs .harness/scripts/jev-client.test.mjs .harness/scripts/command-gate.test.mjs .harness/scripts/sync-knowledge.test.mjs .harness/scripts/sync-state.test.mjs .agents/mcp/jev-gate-server.test.mjs .harness/scripts/drift-lib.test.mjs .harness/scripts/semgrep-lib.test.mjs .harness/scripts/audit-codebase.test.mjs .harness/scripts/learning-lib.test.mjs .agents/mcp/spec-drift-auditor.test.mjs .agents/modules/http-api/adapters/openapi.test.mjs tools/drift-dashboard/src/model.test.mjs",
    "test:full-flow": "bash scripts/test-full-flow.sh",
    "build:ui": "vite build --config tools/drift-dashboard/vite.config.mjs"
  },
  "keywords": [
    "asdd",
    "harness",
    "ai-agents",
    "cursor",
    "spec-driven",
    "agent-engineering",
    "shape-up",
    "product-delivery"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eencinasq/asdd-harness-kit.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "sqlite-vec": "^0.1.10-alpha.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
