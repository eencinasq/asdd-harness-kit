{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asdd-harness-kit.io/schemas/harness-project.json",
  "title": "ASDD Harness project configuration",
  "type": "object",
  "required": ["schema_version", "project_id", "harness_version", "mode", "paths", "bindings", "modules", "capabilities"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "project_id": { "type": "string", "minLength": 1 },
    "kit": {
      "type": "object",
      "required": ["name", "source", "ref"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "installed_at": { "type": "string", "format": "date-time" }
      }
    },
    "harness_version": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["full", "lite", "hotfix", "escalated"] },
    "stop": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": ["fail_closed", "advisory"],
          "description": "Verify-on-Stop: fail_closed blocks the session on check FAIL; advisory runs check + learning but does not block."
        }
      }
    },
    "bindings_complete": { "type": "boolean" },
    "paths": {
      "type": "object",
      "required": ["steering", "specs", "state", "features", "progress_index"],
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "bindings": {
      "type": "object",
      "required": ["product", "structure", "tech", "domain_layer", "quality_gates"],
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "commands": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
    "modules": { "type": "object", "additionalProperties": { "type": "boolean" } },
    "drift": {
      "type": "object",
      "properties": {
        "contract": { "enum": ["warn", "fail"], "description": "Severity of DRIFT-06 (every feature has scope_paths; passing features have evidence)." },
        "intent_evidence": { "enum": ["warn", "fail"], "description": "Severity of INTENT-EVIDENCE: unresolvable grounding refs in an in-progress slice's intent.md (asdd intake)." }
      }
    },
    "tracker": {
      "type": "object",
      "description": "Where the PO/PM keeps pitches and Intent items (format: cli/skills/external-trackers/references/intent-format.md). Optional; validated by asdd check-config.",
      "required": ["type", "project", "pitch", "intent"],
      "properties": {
        "type": { "enum": ["jira", "linear", "github"] },
        "project": { "type": "string", "minLength": 1, "description": "jira: project key (PROD); linear: team key (ENG); github: owner/repo." },
        "site": { "type": "string", "minLength": 1, "description": "jira only: the Atlassian site host (acme.atlassian.net)." },
        "pitch": {
          "type": "object",
          "properties": {
            "issue_type": { "type": "string", "minLength": 1, "description": "jira: issue type of a pitch (Epic)." },
            "container": { "enum": ["project", "issue"], "description": "linear: a pitch is a Linear project or a labelled issue." },
            "label": { "type": "string", "minLength": 1, "description": "github (and linear container=issue): label of a pitch issue." }
          }
        },
        "intent": {
          "type": "object",
          "properties": {
            "issue_type": { "type": "string", "minLength": 1, "description": "jira: issue type of an Intent item (Story)." },
            "label": { "type": "string", "minLength": 1, "description": "Label of an Intent item (required for linear and github; jira needs issue_type or label)." }
          }
        }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "jira" } } }, "then": { "required": ["site"], "properties": { "project": { "pattern": "^[A-Z][A-Z0-9_]+$" }, "pitch": { "required": ["issue_type"] }, "intent": { "anyOf": [{ "required": ["issue_type"] }, { "required": ["label"] }] } } } },
        { "if": { "properties": { "type": { "const": "linear" } } }, "then": { "properties": { "project": { "pattern": "^[A-Z][A-Z0-9]*$" }, "pitch": { "required": ["container"] }, "intent": { "required": ["label"] } } } },
        { "if": { "properties": { "type": { "const": "github" } } }, "then": { "properties": { "project": { "pattern": "^[\\w.-]+/[\\w.-]+$" }, "pitch": { "required": ["label"] }, "intent": { "required": ["label"] } } } }
      ]
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "spec_as_source": {
          "type": "boolean",
          "description": "Experimental: enable asdd spec-source inventory (not default SoT)."
        },
        "telemetry": {
          "type": "object",
          "description": "Fail-open telemetry (profiling v2): spans.jsonl producer instrumentation is on when present.",
          "properties": {
            "enabled": { "type": "boolean" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
