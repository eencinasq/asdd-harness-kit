{
  "id": "rerun-until-pass",
  "task": "mutation-testing REQ-013: re-run asdd mutate until pass, and stop on unconfigured / no-files / error (AMB-010)",
  "expect": "the loop ends on pass and stops on the other results",
  "probes": [
    {
      "id": "p1",
      "run": "{asdd} mutate --help",
      "cwd": "repo"
    }
  ],
  "assertions": [
    {
      "type": "exit_code",
      "probe": "p1",
      "code": 0
    },
    {
      "type": "stdout_matches",
      "probe": "p1",
      "pattern": "--feature <TASK-NNN>"
    },
    {
      "type": "skill_contains",
      "pattern": "until it\n  reports `pass`"
    },
    {
      "type": "skill_contains",
      "pattern": "On `unconfigured` or `no-files`, write that"
    },
    {
      "type": "skill_contains",
      "pattern": "on `error`, stop and escalate"
    }
  ]
}
