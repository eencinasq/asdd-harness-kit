{
  "id": "scope-grounding",
  "task": "Split a bet pitch into scopes that reuse what the repository already has",
  "expect": "the knowledge index builds and reports its nodes (the grounding step reads it); the skill keeps the per-scope grounding and the merge-or-cut rule",
  "probes": [
    {
      "id": "slice",
      "run": "{asdd} knowledge sync && {asdd} knowledge status",
      "cwd": "repo"
    }
  ],
  "assertions": [
    {
      "type": "exit_code",
      "probe": "slice",
      "code": 0
    },
    {
      "type": "stdout_matches",
      "probe": "slice",
      "pattern": "\"nodes\""
    },
    {
      "type": "skill_contains",
      "pattern": "### Step 3: Ground the scopes"
    },
    {
      "type": "skill_contains",
      "pattern": "Reuse / Extend / New"
    },
    {
      "type": "skill_contains",
      "pattern": "merge or cut"
    },
    {
      "type": "skill_contains",
      "pattern": "references/grounding.md"
    }
  ]
}
