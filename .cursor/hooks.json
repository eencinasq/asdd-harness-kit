{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node cli/bin/asdd.mjs gate",
        "timeout": 30,
        "failClosed": true
      }
    ],
    "stop": [
      {
        "command": "node cli/bin/asdd.mjs verify",
        "timeout": 60,
        "loop_limit": 3,
        "failClosed": true
      }
    ]
  }
}
