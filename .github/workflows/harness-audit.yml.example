# Example: scheduled codebase audit (computational pass only).
# Copy to .github/workflows/harness-audit.yml to enable. The runner is the project's choice; see
# https://github.com/eencinasq/asdd-harness-kit#codebase-auditor
# The inferential pass (codebase-audit skill) needs an agent runtime and is not run here.
# It also records failing invariants as learning signals (author `ci`) and commits the weekly summary.
name: harness-audit

on:
  schedule:
    - cron: '0 6 * * 1'
  workflow_dispatch:

permissions:
  contents: write

jobs:
  audit:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
      - name: Sync state
        run: node .harness/scripts/sync-state.mjs
      - name: Audit
        run: node .harness/scripts/audit-codebase.mjs
      - name: Learning signals (CI failures on the default branch)
        env:
          HARNESS_RUNTIME: ci
          HARNESS_AUTHOR: ci
        run: |
          node .harness/scripts/check-invariants.mjs --record || true
          node .harness/scripts/learn.mjs --all
      - name: Commit report
        run: |
          git config user.name 'harness-audit'
          git config user.email 'harness-audit@users.noreply.github.com'
          git add .harness/audits/ .harness/state/learning/
          git diff --cached --quiet || git commit -m 'chore(audit): scheduled codebase audit'
          git push
