      "owns": [
        "installed_copy",
        "steering",
        "agent",
        "skill",
        "rule",
        "adapter",
        "module"
      ]
    },
    "vendor": {
      "run": "asdd kit vendor",
      "check": "asdd kit vendor --check",
      "owns": [
        "vendored_copy"
      ],
      "notes": "Q-R3 Phase-2 arm resolved: vendoring kept \u2014 bundle-consumption restructure declined (D-4c). tools/*/src/harness copies stay tracked with -merge; conflict resolution = asdd kit vendor, never hunk-editing."
    },
    "runtime-steering": {
      "run": "asdd kit generate-runtime-steering",
      "check": "asdd kit generate-runtime-steering --check",
      "owns": [
        "partially_generated"
      ]
    },
    "versions": {
      "run": "asdd kit versions",
      "check": "asdd kit versions --check",
      "owns": [
        "version_stamp"
      ]
    },
    "sync-state": {
      "run": "asdd sync",
      "check": "asdd check",
      "owns": [
        "derived_singleton",
        "progress_doc",
        "feature_tracker"
      ]
    },
    "learn": {
      "run": "asdd learn",
      "check": "asdd learn --check",
      "owns": [
        "learning_summary",
        "derived_singleton"
      ]
    },
    "sync-knowledge": {
      "run": "asdd knowledge sync",
      "check": "asdd knowledge sync --check",
      "owns": [
        "state_derived_read"
      ]
    },
    "skills-index": {
      "run": "asdd skills-index --write",
      "check": "asdd skills-index",
      "owns": [
        "skill"
      ]
    },
    "build": {
      "run": "npm run build",
      "check": "asdd kit build --check",
      "owns": [
        "kit_source"
      ]
    },
    "install": {
      "run": "npx asdd-harness-kit install <dir>",
      "check": "cli/test/install.sh + lifecycle.sh",
      "owns": [
        "managed_config",
        "seeded_scaffold",
        "binding",
        "hook",
        "runtime_adapter",
        "mcp_server"
      ]
    },
    "harness-profile": {
      "run": "asdd profile --slice <id>",
      "check": null,
      "owns": [
        "profiling_rollup"
      ],
      "notes": "Phase 2 \u2014 profiling lineage"
    }
  },
  "vocabulary": {
    "phases": [
      {
        "id": "discovery",
        "order": 1,
        "gate": "capability.md",
        "owning_agents": [
          "asdd-discovery-agent"
        ],
        "steering_tag": "discovery"
      },
      {
        "id": "spec",
        "order": 2,
        "gate": "requirements.md",
        "owning_agents": [
          "asdd-spec-agent"
        ],
        "steering_tag": "spec"
      },
      {
        "id": "validation",
        "order": 3,
        "gate": "spec-validation-report.md",
        "owning_agents": [
          "asdd-validation-agent"
        ],
        "steering_tag": "validation"
      },
      {
        "id": "domain",
        "order": 4,
        "gate": "domain-model.md",
        "owning_agents": [
          "asdd-domain-agent"
        ],
        "steering_tag": "domain"
      },
      {
        "id": "design",
        "order": 5,
        "gate": "design.md",
        "owning_agents": [
          "asdd-design-agent"
        ],
        "steering_tag": "design"
      },
      {
        "id": "task_planning",
        "order": 6,
        "gate": "tasks.md",
        "owning_agents": [
          "asdd-task-planning-agent"
        ],
        "steering_tag": "task_planning"
      },
      {
        "id": "implementation",
        "order": 7,
        "gate": "features passing",
        "owning_agents": [
          "asdd-implementation-agent"
        ],
        "steering_tag": "implementation"
      },
      {
        "id": "qa",
        "order": 8,
        "gate": "spec-coverage-report.md",
        "owning_agents": [
          "asdd-qa-agent"
        ],
        "steering_tag": "qa"
      },
      {
        "id": "knowledge",
        "order": 9,
        "gate": "learn proposals",
        "owning_agents": [
          "asdd-knowledge-agent"
        ],
        "steering_tag": "knowledge"
      }
    ],
    "modes": [
      "lite",
      "hotfix",
      "full",
      "escalated"
    ],
    "roles": [
      "review",
      "ui"
    ]
  },
  "commands": {
    "harness": {
      "check": {
        "script": "check-invariants.mjs",
        "help": "every harness invariant and spec drift (Verify-on-Stop runs it)"
      },
      "verify": {
        "script": "verify-on-stop.mjs",
        "help": "the Stop hook: runs check --live, blocks the session on FAIL (stdin: hook payload)"
      },
      "gate": {
        "script": "command-gate.mjs",
        "help": "the shell command hook: allow / deny (stdin: hook payload)"
      },
      "drift": {
