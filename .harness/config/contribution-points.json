      "vendor": "./kit/vendor.mjs",
      "guidance": "./kit/guidance.mjs",
      "skills-lint": "./kit/skills-lint.mjs",
      "agents-lint": "./kit/agents-lint.mjs",
      "self": "./kit/self.mjs",
