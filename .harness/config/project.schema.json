{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draft-ly.app/schemas/harness-project.json",
  "title": "ASDD Harness project configuration",
  "type": "object",
  "required": ["schema_version", "project_id", "harness_version", "mode", "paths", "bindings", "modules", "capabilities"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "project_id": { "type": "string", "minLength": 1 },
    "kit": {
      "type": "object",
      "required": ["name", "source", "ref"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "harness_version": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["full", "lite"] },
    "bindings_complete": { "type": "boolean" },
    "paths": {
      "type": "object",
      "required": ["steering", "specs", "state", "features", "progress", "progress_index", "locks"],
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "bindings": {
      "type": "object",
      "required": ["product", "structure", "tech", "domain_layer", "quality_gates"],
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "commands": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
    "modules": { "type": "object", "additionalProperties": { "type": "boolean" } },
    "capabilities": { "type": "object" }
  }
}
